{
  "name": "song-presentation",
  "productName": "SongPresentation",
  "version": "0.1.2",
  "private": true,
  "description": "Bilingual song lyrics presentation for LAN displays and OBS.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,app \"vite build --watch --mode development\" \"wait-on dist/index.html dist/display.html dist/remote.html && electron .\"",
    "server": "vite build && node server/server.cjs",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "dist:win": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac",
    "release": "vite build && electron-builder --publish always"
  },
  "build": {
    "appId": "no.koach.songpresentation",
    "productName": "SongPresentation",
    "files": [
      "electron/**",
      "server/**",
      "dist/**",
      "package.json",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "identity": "SEBASTIAN KĘDZIOR (Q9SMQCVNWJ)",
      "notarize": true
    },
    "directories": {
      "output": "release"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SongPresentation"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "eliassk",
        "repo": "SongPresentation",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/svelte": "^1.76.0",
    "electron-updater": "^6.8.11",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eliassk/SongPresentation.git"
  }
}
